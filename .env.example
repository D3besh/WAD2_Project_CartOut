# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/sidekick
SESSION_SECRET=change-me-to-a-long-random-string

# External APIs (keys stay on the server only)
GEMINI_API_KEY=
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
DATAGOVSG_API_KEY=

# Set to true in tests to use files in tests/mocks instead of real APIs
USE_MOCK_APIS=false
